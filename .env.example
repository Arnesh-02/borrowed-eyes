# Optional PRIVATE development endpoint. Empty = no inference networking.
# Android emulator: http://10.0.2.2:11434
# USB adb reverse: http://127.0.0.1:11434 (see development guide)
# Physical device Wi-Fi: explicitly choose your computer's private IPv4 address.
EXPO_PUBLIC_OLLAMA_URL=
EXPO_PUBLIC_GEMMA_MODEL=gemma3:1b
# For a private Android native development build only; rebuild after changing.
BORROWED_EYES_DEV_HTTP=0
